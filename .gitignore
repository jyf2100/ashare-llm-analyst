# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 虚拟环境 =====
.venv/
venv/

# ===== IDE / 编辑器 =====
.idea/
.vscode/
.trae/
*.swp

# ===== 密钥（真实值不入库；.env.example 入库）=====
.env
*.env.local

# ===== 数据 / 产物 / 日志目录（体积大、可重生，不入库）=====
# 这些目录名在仓库任意层级都被忽略（根级与 out/ 下同名目录）
market_data/
downloads/
models/
reports/
rps_results/
training_data/
cache/
logs/
charts/
results/
state_archive/
crontab_backups/
test_reports/
test_e2e_reports/
*.log

# ===== back/ 下的数据产物（分析报告 / 训练备份 / numpy 特征标签）=====
# back/ 只跟踪 .py 源码（8 个），这些 .json/.csv/.txt 是运行产物，不入库。
# dev-agent 自治提交时跑 `git add -A`——本仓为公开仓，防把数据扫进 PR / 泄到远端。
back/training_data_backup_*/
back/*.json
back/*.csv
back/test_stocks.txt

# numpy 数组一律是数据产物（特征 / 标签），仓库任意层级忽略
*.npy

# ===== OS =====
.DS_Store
Thumbs.db

# 注意：所有 .py 源码（src/ tests/ back/ deep-search/ out/）默认入库，不做忽略

# Claude Code 配置
.claude/

# 分析图片产物
back/*.png

# ashare-llm-analyst 根配置模板
# 用法: cp .env.example .env 后填入真实值。.env 不入库。

# OpenAI 兼容 API（内部 Qwen 部署，key 未必 sk- 开头）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://your-internal-endpoint/v1
OPENAI_MODEL=Qwen3-Next-80B-A3B

# 搜索 API（Tavily）
SEARCH_API_KEY=tvly-xxxxxxxxxxxxx

# 代理（按需取消注释）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# MCP 知识库
WEKNORA_KB_ID=your-kb-id
